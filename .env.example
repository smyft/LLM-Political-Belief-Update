# Copy this file to .env and replace the placeholder with your own key.
# Never commit a real API key.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: override only if OpenRouter provides a different HTTPS endpoint.
# Non-OpenRouter hosts require an explicitly paired key in application code;
# OPENROUTER_API_KEY is never forwarded to another host.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
